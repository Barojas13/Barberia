# Example environment values for local/production overrides.
# Copy to a private place or set these in Render → Environment.

ASPNETCORE_ENVIRONMENT=Production

# Local SQLite:
# ConnectionStrings__DefaultConnection=Data Source=barberia.db

# Production Postgres (Neon) — paste the full URI from neon.tech:
ConnectionStrings__DefaultConnection=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

Jwt__Issuer=Gemelli.Studio.Api
Jwt__Audience=Gemelli.Studio.Web
Jwt__Key=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
Jwt__ExpirationMinutes=120
Cors__AllowedOrigins__0=https://REPLACE_WITH_WEB_URL.onrender.com
SeedOnStartup=true
